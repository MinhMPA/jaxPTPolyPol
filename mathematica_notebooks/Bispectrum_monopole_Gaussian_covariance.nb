    RowBox[{"DResults", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "=!=", "0"}], "&"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{"nonZeroD", ",", 
   RowBox[{"TableHeadings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<\[ScriptL]1\>\"", ",", "\"\<\[ScriptL]2\>\"", 
        ",", "\"\<\[ScriptL]3\>\"", 
        ",", "\"\<D_{\[ScriptL]1,\[ScriptL]2,\[ScriptL]3}\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",
