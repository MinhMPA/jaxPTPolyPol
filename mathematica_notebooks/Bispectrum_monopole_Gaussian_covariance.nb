      RowBox[{"sight", ".", "\[IndentingNewLine]", 
       RowBox[{"\[Omega]", ":", " ", 
        RowBox[{
        "polar", " ", "angle", " ", "between", " ", "k1", " ", "and", " ", 
         RowBox[{"LOS", ".", "\[IndentingNewLine]", "\[Phi]"}]}], ":", " ", 
        RowBox[{
        "azimuthal", " ", "angle", " ", "of", " ", "k2", " ", "around", " ", 
         RowBox[{"k1", ".", "\[IndentingNewLine]", 
          RowBox[{"\[Theta]12", ":", " ", 
           RowBox[{
           "angle", " ", "between", " ", "k1", " ", "and", " ", 
            "k2"}]}]}]}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]12", "]"}], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"k3", "^", "2"}], "-", 
          RowBox[{"k1", "^", "2"}], "-", 
          RowBox[{"k2", "^", "2"}]}], ")"}], "/", 
        RowBox[{"(", 
