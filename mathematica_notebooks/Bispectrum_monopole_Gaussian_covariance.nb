Cell["\<\
Verify that the mu3 expression is consistent with the triangle closure \
condition mu3 = -(k1 mu1 + k2 mu2)/k3 under the substitution Cos[\[Theta]13] \
= -(k1 + k2 Cos[\[Theta]12])/k3 and Sin[\[Theta]13] = k2 Sin[\[Theta]12]/k3 \
(sine rule).\
\>", "Text",
 CellChangeTimes->{{
   3.958 e9, 3.958 
    e9}},ExpressionUUID->"1fd141c6-3f87-4d38-b37f-a9df753e9fb7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mu3Direct", "=", 
   RowBox[{
    RowBox[{"-", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"k1", " ", "mu1"}], "+", 
       RowBox[{"k2", " ", "mu2"}]}], ")"}]}], "/", "k3"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mu3Sub", "=", 
   RowBox[{"mu3", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]13", "]"}], "\[Rule]", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"k1", "+", 
           RowBox[{"k2", " ", 
            RowBox[{"Cos", "[", "\[Theta]12", "]"}]}]}], ")"}]}], "/", 
        "k3"}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Theta]13", "]"}], "\[Rule]", 
       RowBox[{
        RowBox[{"k2", " ", 
         RowBox[{"Sin", "[", "\[Theta]12", "]"}]}], "/", "k3"}]}]}], 
     "}"}]}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"mu3Direct", "-", "mu3Sub"}], "]"}]}], "Input",
 CellChangeTimes->{{3.958 e9, 3.958 e9}},
 CellLabel->"In[53]:=",ExpressionUUID->"b53d546d-f6fc-4548-97f7-07ab2cca1516"],

