       RowBox[{"{", 
        RowBox[{"l3", ",", "ells"}], "}"}]}], "]"}], ",", "2"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"nonZeroD", "=", 
