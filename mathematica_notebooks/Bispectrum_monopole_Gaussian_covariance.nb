Cell[TextData[{
 StyleBox["Comparison with Eq. (4.3) and Appendix F of Ivanov et al. (2021) \
[arXiv:",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["2110.10161",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2110.10161"], None},
  ButtonNote->"https://arxiv.org/abs/2110.10161"],
  FontWeight->"Bold"],
 StyleBox["], and Eq. (19-20) of Song et al (2015) [arXiv:",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["1502.03099",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/1502.03099"], None},
  ButtonNote->"https://arxiv.org/abs/1502.03099"],
  FontWeight->"Bold"],
 StyleBox["]",
  FontWeight->"Bold"],
 "\n\nBoth papers use the tree-level (Kaiser) power spectrum\nP_g(k,\[Mu]) = \
(b1 + f \[Mu]^2)^2 P_lin(k), which gives the multipoles:\n  Pt0(k) = (b1^2 + \
2 b1 f/3 + f^2/5) P_lin(k) + 1/nbar\n  P2(k) = (4 b1 f/3 + 4 f^2/7) P_lin(k)\n\
  P4(k) = (8 f^2/35) P_lin(k)\n\nWe substitute these into our general \
expression and verify that the result matches the direct integration of the \
Kaiser model.\n"
}], "Text",
 CellChangeTimes->{{3.958 e9, 3.958 e9}, 3.9834930878231573`*^9, {
   3.983606216848428*^9, 3.9836062181378727`*^9}, {3.98360626563057*^9, 
   3.983606345896132*^9}, {3.983606390722185*^9, 3.983606390722473*^9}, {
   3.983606596408712*^9, 3.983606632895125*^9}, {3.9836068715408487`*^9, 
   3.98360689207617*^9}, {3.983607169992442*^9, 
   3.983607192615315*^9}},ExpressionUUID->"eddc60d0-6433-4002-a400-\
2dd9155a43cd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"kaiserRules", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Pt0", "[", "k_", "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["b1", "2"], "+", 
          FractionBox[
           RowBox[{"2", " ", "b1", " ", "f"}], "3"], "+", 
          FractionBox[
           SuperscriptBox["f", "2"], "5"]}], ")"}], " ", 
        RowBox[{"Plin", "[", "k", "]"}]}], "+", 
       FractionBox["1", "nbar"]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P2", "[", "k_", "]"}], "\[RuleDelayed]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         FractionBox[
          RowBox[{"4", " ", "b1", " ", "f"}], "3"], "+", 
         FractionBox[
          RowBox[{"4", " ", 
           SuperscriptBox["f", "2"]}], "7"]}], ")"}], " ", 
       RowBox[{"Plin", "[", "k", "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"P4", "[", "k_", "]"}], "\[RuleDelayed]", 
      RowBox[{
       FractionBox[
        RowBox[{"8", " ", 
         SuperscriptBox["f", "2"]}], "35"], " ", 
       RowBox[{"Plin", "[", "k", "]"}]}]}]}], "\[IndentingNewLine]", "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"covKaiser", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"covIntegral", "/.", "kaiserRules"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Direct", " ", "integration", " ", "of", " ", "the", " ", "Kaiser", " ", 
     "model", " ", "for", " ", "cross"}], "-", "check"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"PgK", "[", 
    RowBox[{"mu_", ",", "k_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"b1", "+", 
        RowBox[{"f", " ", 
         SuperscriptBox["mu", "2"]}]}], ")"}], "2"], " ", 
     RowBox[{"Plin", "[", "k", "]"}]}], "+", 
    FractionBox["1", "nbar"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"intK", "=", 
   RowBox[{
    RowBox[{"Sin", "[", "\[Omega]", "]"}], " ", 
    RowBox[{"PgK", "[", 
     RowBox[{"mu1", ",", "k1"}], "]"}], " ", 
    RowBox[{"PgK", "[", 
     RowBox[{"mu2", ",", "k2"}], "]"}], " ", 
    RowBox[{"PgK", "[", 
     RowBox[{"mu3", ",", "k3"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"covDirectK", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", " ", "Pi"}]], " ", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"Integrate", "[", 
          RowBox[{"intK", ",", 
           RowBox[{"{", 
            RowBox[{"\[Phi]", ",", "0", ",", 
             RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Omega]", ",", "0", ",", "Pi"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"Assumptions", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]12", "]"}], ">", "0"}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]13", "]"}], ">", "0"}]}], "}"}]}]}], 
     "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Verify", ":", " ", "should"}], " ", "give", " ", "0"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"covKaiser", "-", "covDirectK"}], "]"}]}], "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"7cb4a899-38c1-4536-84a6-fe74ce8696e5"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.983607763088685*^9, 3.983608269134706*^9},
 CellLabel->"Out[75]=",ExpressionUUID->"6520f44e-2470-4f74-a671-0f643349979c"]
}, Open  ]],

Cell[TextData[{
 "\n",
 StyleBox["Comparison with Eq. (2.13-2.15) of Salvalaggio et al. (2024) \
[arXiv:",
  FontWeight->"Bold"],
 StyleBox[ButtonBox["2403.08634",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://arxiv.org/abs/2403.08634"], None},
  ButtonNote->"https://arxiv.org/abs/2403.08634"],
  FontWeight->"Bold"],
 StyleBox["] and Eq.(4.4-4.8) of Rizzo et al. (2022) [arXiv:2204.13628]",
  FontWeight->"Bold"],
 "\n\nSetting \[ScriptL]1 = \[ScriptL]2 = 0 (monopole-monopole) in their Eq. \
(2.13), the bracket containing Kronecker deltas and Legendre polynomials \
reduces to s_{123} (= 6, 2, 1 for equilateral, isosceles, general triangles), \
since L_0(\[Mu]) = 1.\n\nTheir Eq. (2.14) in the continuum limit then \
becomes:\n  C^{B}_{00} = [s_{123}/(N_t k_f^3)] \[Delta]_{ij} \
\[CapitalSigma]_{l3,l4,l5} D_{l3,l4,l5} P_{tot,l3}(k1) P_{tot,l4}(k2) \
P_{tot,l5}(k3)\n\nwhere D_{l3,l4,l5} = R_{0,0,l3,l4,l5} / s_{123} is the \
angular integral from their Eq. (A.7):\n  D_{l3,l4,l5} = 1/(4\[Pi]) \
\[Integral] d\[Mu]1 d\[Xi] L_{l3}(\[Mu]1) L_{l4}(\[Mu]2) L_{l5}(\[Mu]3)\n\n\
with the same Scoccimarro coordinate system:\n  \[Mu]2 = \[Mu]1 \[Nu]12 - \
\[Sqrt](1-\[Mu]1^2) \[Sqrt](1-\[Nu]12^2) cos(\[Xi]12)\n\nThis is identical to \
our D coefficients computed above."
}], "Text",
 CellChangeTimes->{{3.958 e9, 3.958 e9}, 3.9834930878231573`*^9, {
   3.983606216848428*^9, 3.9836062181378727`*^9}, {3.98360626563057*^9, 
   3.983606345896132*^9}, {3.983606390722185*^9, 3.983606390722473*^9}, {
   3.983606596408712*^9, 3.983606632895125*^9}, {3.9836068715408487`*^9, 
   3.98360689207617*^9}, {3.983607169992442*^9, 
   3.983607184482771*^9}},ExpressionUUID->"0d3bf910-b9ed-4f11-86a9-\
77f45ef3abb9"],

Cell["\<\
Summary:

The Gaussian covariance of the bispectrum monopole [Eq. (B.3)] is:

  C^{B,l=0}_{TT'} = (2\[Pi])^3/V(z) \[Times] \[Pi] s_{123}/(dk1 dk2 dk3 k1 k2 \
k3) \[Times] \[Delta]_{TT'} \[Times] I(k1,k2,k3)

where s_{123} = 6, 2, 1 for equilateral, isosceles, and general triangles, \
and I(k1,k2,k3) = covIntegral is the angular integral derived above.

The result decomposes into D_{l1,l2,l3} coefficients (angular averages of \
triple Legendre polynomial products) multiplying products of power spectrum \
multipoles Pt_l1(k1) Pt_l2(k2) Pt_l3(k3).

Compare the explicit D coefficients with:
- Eq. (2.13-2.14) of Salvalaggio et al. (2024) [arXiv:2403.08634] with \
\[ScriptL]1=\[ScriptL]2=0, where R_{0,0,l3,l4,l5} = s_{123} \[Times] \
D_{l3,l4,l5}.\
\>", "Text",
 CellChangeTimes->{{3.958 e9, 3.958 e9}, 3.983492782608457*^9, {
   3.983492836391841*^9, 3.983492865320877*^9}, {3.983493224263074*^9, 
   3.983493224959674*^9}},ExpressionUUID->"9edce4e1-57ef-4e1e-a351-\
506fe8aaf081"]
},
