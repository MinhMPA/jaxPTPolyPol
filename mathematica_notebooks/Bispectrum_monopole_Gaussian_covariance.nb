Cell["\<\
Define the D coefficients: angular-averaged products of Legendre polynomials.

D_{l1,l2,l3}(\[Theta]12,\[Theta]13) = 1/(4\[Pi]) \[Integral]_0^{2\[Pi]} d\
\[Phi] \[Integral]_0^{\[Pi]} d\[Omega] sin\[Omega] L_{l1}(\[Mu]1) \
L_{l2}(\[Mu]2) L_{l3}(\[Mu]3)

The full angular integral decomposes as:
I(k1,k2,k3) = \[CapitalSigma]_{l1,l2,l3} D_{l1,l2,l3} Pt_{l1}(k1) Pt_{l2}(k2) \
Pt_{l3}(k3)

where Pt_0(k) = P_0(k) + 1/nbar absorbs the shot noise, and Pt_2 = P_2, Pt_4 \
= P_4.\
\>", "Text",
 CellChangeTimes->{{
   3.958 e9, 3.958 
    e9}},ExpressionUUID->"d2186d23-76d8-4439-87d7-991a0641e9f7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ells", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DCoeff", "[", 
     RowBox[{"l1_", ",", "l2_", ",", "l3_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"DCoeff", "[", 
      RowBox[{"l1", ",", "l2", ",", "l3"}], "]"}], "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"integrand", ",", "phiResult"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"integrand", "=", 
         RowBox[{
          RowBox[{"L", "[", 
           RowBox[{"l1", ",", "mu1"}], "]"}], " ", 
          RowBox[{"L", "[", 
           RowBox[{"l2", ",", "mu2"}], "]"}], " ", 
          RowBox[{"L", "[", 
           RowBox[{"l3", ",", "mu3"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"phiResult", "=", 
         RowBox[{"Integrate", "[", 
          RowBox[{"integrand", ",", 
           RowBox[{"{", 
            RowBox[{"\[Phi]", ",", "0", ",", 
             RowBox[{"2", " ", "Pi"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"4", " ", "Pi"}]], " ", 
           RowBox[{"Integrate", "[", 
            RowBox[{
             RowBox[{"phiResult", " ", 
              RowBox[{"Sin", "[", "\[Omega]", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"\[Omega]", ",", "0", ",", "Pi"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"Assumptions", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]12", "]"}], ">", "0"}], ",", 
             RowBox[{
              RowBox[{"Sin", "[", "\[Theta]13", "]"}], ">", "0"}]}], 
            "}"}]}]}], "]"}]}]}], "]"}]}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Compute", " ", "and", " ", "display", " ", "non", "-", 
    RowBox[{"zero", " ", "D", " ", "coefficients"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"DResults", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"l1", ",", "l2", ",", "l3", ",", 
         RowBox[{"DCoeff", "[", 
          RowBox[{"l1", ",", "l2", ",", "l3"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"l1", ",", "ells"}], "}"}], ",", 
