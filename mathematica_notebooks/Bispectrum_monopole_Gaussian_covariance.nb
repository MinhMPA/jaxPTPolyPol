     RowBox[{"LegendreP", "[", 
      RowBox[{"ell", ",", "mu"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Direction", " ", "cosines", " ", 
