Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "Legendre", " ", "polynomial", " ", "generator"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"L", "[", 
     RowBox[{"ell_", ",", "mu_"}], "]"}], ":=", 
    RowBox[{"LegendreP", "[", 
     RowBox[{"ell", ",", "mu"}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "general", " ", "power", " ", "spectrum", " ", "multipole",
      " ", "expansion"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "[", 
     RowBox[{"mu_", ",", "k_", ",", "coeffs_", ",", "ells_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"coeffs", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", "k", "]"}], "*", 
       RowBox[{"L", "[", 
        RowBox[{
         RowBox[{"ells", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "mu"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "ells", "]"}]}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "covariance", " ", "prefactor"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CovPrefactor", "[", 
     RowBox[{"ell1_", ",", "ell2_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "ell1"}], "+", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "ell2"}], "+", "1"}], ")"}]}], ")"}], "/", "2"}]}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "integrand", " ", "of", " ", "the", " ", 
     "Gaussian", " ", "covariance"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CovIntegrand", "[", 
     RowBox[{
     "ell1_", ",", "ell2_", ",", "mu_", ",", "k_", ",", "coeffs_", ",", 
      "ells_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"L", "[", 
      RowBox[{"ell1", ",", "mu"}], "]"}], "*", 
     RowBox[{"L", "[", 
      RowBox[{"ell2", ",", "mu"}], "]"}], "*", 
     RowBox[{
      RowBox[{"P", "[", 
       RowBox[{"mu", ",", "k", ",", "coeffs", ",", "ells"}], "]"}], "^", 
      "2"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Perform", " ", "the", " ", "mu"}], "-", 
     RowBox[{
     "integral", " ", "symbolically", " ", "with", " ", "assumptions"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"IntegralOverMu", "[", 
     RowBox[{"ell1_", ",", "ell2_", ",", "k_", ",", "coeffs_", ",", "ells_"}],
      "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "mu", "}"}], ",", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{"Integrate", "[", 
        RowBox[{
         RowBox[{"CovIntegrand", "[", 
          RowBox[{
          "ell1", ",", "ell2", ",", "mu", ",", "k", ",", "coeffs", ",", 
           "ells"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"mu", ",", 
           RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Full", " ", "Gaussian", " ", "covariance", " ", "block", " ", "for", " ",
      "input", " ", "multipoles"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Cov", "[", 
     RowBox[{"ell1_", ",", "ell2_", ",", "k_", ",", "coeffs_", ",", "ells_"}],
      "]"}], ":=", 
    RowBox[{
     RowBox[{"CovPrefactor", "[", 
      RowBox[{"ell1", ",", "ell2"}], "]"}], "*", 
     RowBox[{"IntegralOverMu", "[", 
      RowBox[{"ell1", ",", "ell2", ",", "k", ",", "coeffs", ",", "ells"}], 
      "]"}]}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "the", " ", "covariance", " ", "matrix"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CovMatrix", "[", 
     RowBox[{"k_", ",", "coeffs_", ",", "ells_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Cov", "[", 
       RowBox[{"ell1", ",", "ell2", ",", "k", ",", "coeffs", ",", "ells"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ell1", ",", "ells"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"ell2", ",", "ells"}], "}"}]}], "]"}]}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Set", " ", "number", " ", "of", " ", "multipoles", " ", "and", " ", 
     "their", " ", "order", " ", "in", " ", "the", " ", "expansion"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ells", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], ";"}], " ", "\n", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"P0", "[", "k", "]"}], ",", 
       RowBox[{"P2", "[", "k", "]"}], ",", 
       RowBox[{"P4", "[", "k", "]"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"order", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"P0", "[", "k", "]"}], "^", "2"}], ",", 
       RowBox[{
        RowBox[{"P0", "[", "k", "]"}], "*", 
        RowBox[{"P2", "[", "k", "]"}]}], ",", 
       RowBox[{
        RowBox[{"P0", "[", "k", "]"}], "*", 
        RowBox[{"P4", "[", "k", "]"}]}], ",", 
       RowBox[{
        RowBox[{"P2", "[", "k", "]"}], "^", "2"}], ",", 
       RowBox[{
        RowBox[{"P2", "[", "k", "]"}], "*", 
        RowBox[{"P4", "[", "k", "]"}]}], ",", 
       RowBox[{
        RowBox[{"P4", "[", "k", "]"}], "^", "2"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coeffs", "=", 
     RowBox[{"Association", "@@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ells", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "->", 
         RowBox[{"Symbol", "[", 
          RowBox[{"\"\<P\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"ells", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "ells", "]"}]}], "}"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "Association", " ", "to", " ", "ordered", " ", "list", " ",
      "of", " ", "functions"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"coeffList", "=", 
     RowBox[{"Lookup", "[", 
      RowBox[{"coeffs", ",", "ells"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Evaluate", " ", "and", " ", "simplify", " ", "covariance", " ", 
     "matrix"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"covMatrixExpr", "=", 
     RowBox[{"CovMatrix", "[", 
      RowBox[{"k", ",", "coeffList", ",", "ells"}], "]"}]}], ";"}], "\n", 
   RowBox[{"covBlock", "=", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"Expand", "[", 
          RowBox[{"FullSimplify", "[", 
           RowBox[{"#", ",", 
            RowBox[{"Assumptions", "->", 
             RowBox[{"{", 
              RowBox[{"Element", "[", 
               RowBox[{"k", ",", "Reals"}], "]"}], "}"}]}]}], "]"}], "]"}], ",",
          "order"}], "]"}], "&"}], ",", "covMatrixExpr", ",", 
      RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Individual", " ", "matrix", " ", "blocks"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"C00", "=", 
    RowBox[{"covBlock", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "\n", 
   RowBox[{"C02", "=", 
    RowBox[{"covBlock", "[", 
     RowBox[{"[", 
      RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 
