Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"Mu2Derivation", "[", 
   RowBox[{"theta1_", ",", "theta12_", ",", "phi_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "x", ",", "y", ",", "z", ",", "k2PrimeHat", ",", "Ry", ",", "k2Hat", ",",
       "mu1", ",", "mu2"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"Set", " ", "up", " ", "the", " ", "coordinate", " ", "system"}],
      "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"y", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"z", "=", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"We", " ", "assume", " ", "that"}], ",", " ", 
        RowBox[{"at", " ", 
         RowBox[{"first", ":", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "/", " ", "k1"}], " ", "aligns", " ", "with", " ", 
            "the", " ", "z"}], "-", "axis"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"i", ".", "e", ".", " ", "k1PrimeHat"}], "=", "zhat"}], ";",
          "\[IndentingNewLine]", "  ", 
         RowBox[{
          RowBox[{"2", "/", " ", "theta1"}], " ", "=", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"[", 
             RowBox[{"k1PrimeHat", ",", "nhat"}], "]"}], " ", "with", " ", 
            "the", " ", "LOS", " ", "direction", " ", "nhat", " ", "lies", " ",
             "in", " ", "the", " ", "x"}], "-", 
           RowBox[{"z", " ", "plane"}]}]}], ";", "\[IndentingNewLine]", "  ", 
         
         RowBox[{
          RowBox[{"3", "/", " ", "theta12"}], " ", "=", " ", 
          RowBox[{"[", 
           RowBox[{"k1PrimeHat", ",", "k2PrimeHat"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "  ", 
         RowBox[{
          RowBox[{"4", "/", " ", "phi"}], " ", "is", " ", "the", " ", 
          "azimuthal", " ", "angle", " ", "of", " ", "k2", " ", "revolving", " ",
           "around", " ", "k1"}]}], ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"i", ".", "e", ".", " ", "around"}], " ", "the", " ", "z"}],
          "-", 
         RowBox[{"axis", "."}]}]}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"k2PrimeHat", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "theta12", "]"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Cos", "[", "phi", "]"}], " ", "x"}], "+", 
           RowBox[{
            RowBox[{"Sin", "[", "phi", "]"}], " ", "y"}]}], ")"}]}], "+", 
        RowBox[{
         RowBox[{"Cos", "[", "theta12", "]"}], " ", "z"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
         RowBox[{
         "Rotate", " ", "coordinate", " ", "system", " ", "around", " ", 
          "y"}], "-", 
         RowBox[{"axis", " ", "by", " ", "theta1"}]}], ",", " ", 
        RowBox[{
         RowBox[{"according", " ", "to", " ", "the", " ", "right"}], "-", 
         RowBox[{"hand", " ", "rule"}]}], ",", " ", 
        RowBox[{
         RowBox[{
         "to", " ", "align", " ", "nhat", " ", "with", " ", "the", " ", "z"}],
          "-", 
         RowBox[{
          RowBox[{"axis", ".", "\[IndentingNewLine]", "The"}], " ", 
          "coordinate", " ", "system", " ", "is", " ", "now", " ", "similar", 
          " ", "to", " ", "that", " ", 
          RowBox[{
           RowBox[{"in", " ", "[", "1", "]"}], ".", "\[IndentingNewLine]", 
           "\t", 
           RowBox[{"[", "1", "]"}]}], " ", "Scoccimarro"}]}], ",", " ", 
        "Couchman", ",", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Frieman", " ", 
           RowBox[{"(", 
            RowBox[{"ApJ", ",", " ", "1998"}], ")"}]}], ":", " ", "https", 
          ":"}], "//", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"arxiv", ".", "org"}], "/", "abs"}], "/", "astro"}], "-", 
          
          RowBox[{"ph", "/", "9808305."}]}]}]}], "\[IndentingNewLine]", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Ry", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "theta1", "]"}], ",", "0", ",", 
           RowBox[{"Sin", "[", "theta1", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Sin", "[", "theta1", "]"}]}], ",", "0", ",", 
           RowBox[{"Cos", "[", "theta1", "]"}]}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k2Hat", "=", 
       RowBox[{"Ry", ".", "k2PrimeHat"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Compute", " ", "mu2"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"cosine", "[", 
           RowBox[{"k2Hat", ",", "nhat"}], "]"}], " ", "as", " ", "the", " ", 
          "z"}], "-", 
         RowBox[{
         "component", " ", "of", " ", "the", " ", "rotated", " ", "vector", " ",
           "k2Hat"}]}]}], "*)"}], 
      RowBox[{"mu2", "=", 
       RowBox[{"Collect", "[", 
        RowBox[{
         RowBox[{"Simplify", "[", 
          RowBox[{"k2Hat", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "\[Theta]1", "]"}], ",", 
           RowBox[{"Sin", "[", "\[Theta]1", "]"}], ",", 
           RowBox[{"Cos", "[", "\[Theta]12", "]"}], ",", 
           RowBox[{"Sin", "[", "\[Theta]12", "]"}], ",", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
           RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}]}], "]"}]}], ";"}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"{", "mu2", "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Mu2Derivation", "[", 
  RowBox[{"\[Theta]1", ",", " ", "\[Theta]12", ",", " ", "\[Phi]"}], 
  "]"}]}], "Input",
