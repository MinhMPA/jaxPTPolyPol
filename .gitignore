.ruff_cache/

# PyPI configuration file
.pypirc

# Agent/working notes: implementation plans. Narrowed from a blanket `docs/`
# rule on 2026-08-09 because a whole-directory ignore would also block the
# ReadTheDocs sources (docs/conf.py, docs/*.md) and docs/design/.
# NOTE: gitignore does NOT untrack already-tracked files -- the 5 plan docs
# already committed under docs/superpowers/plans/ stay versioned. This only
# stops NEW files in these subtrees. To add one deliberately: git add -f <path>
docs/plans/
docs/superpowers/

# Agent-facing / internal working files: kept local, never published.
# Untracked 2026-08-22 (`git rm --cached`), matching the docs/ decision --
# current tree only, history retained. CONTEXT.md is the domain decision
# record and CLAUDE.md/AGENTS.md are agent instructions; the public "why"
# now lives in the ReadTheDocs site instead.
CLAUDE.md
CONTEXT.md
AGENTS.md

# scratch notebook, accidentally committed 84b88bd, untracked same day
example/mcmc/_tier2_run.ipynb

# Agent working directory (SDD workspaces, review reports, wip backups) -- scratch.
.superpowers/

# Regenerable bulk in example/mcmc/cache/: rebuild via scripts/build_taylor_templates_lcdm.py
# (templates/whitening) or the chain drivers. The pre-commit hook blocks >10 MB anyway;
# ignoring them stops a broad `git add` from sweeping ~300 MB into the index.
# NOTE: gitignore does NOT untrack -- damh_chain_w.npy (4.5 MB) was tracked before this
# rule and stays tracked. Small JSON evidence artifacts are deliberately NOT ignored.
example/mcmc/cache/taylor_templates_*.npz
example/mcmc/cache/taylor_whitening_*.npz
example/mcmc/cache/*_chain_w.npy

# Cached production MCMC chains (sampler.run_chain_cached): semantic-fingerprint
# npz files, tens-to-hundreds of MB, regenerated by executing the notebooks.
example/mcmc/cache/joint_*_chain_*.npz
example/mcmc/cache/multibin_*_chain_*.npz
